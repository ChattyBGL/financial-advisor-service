ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:3000"]

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
# Arize Phoenix tracing (run `phoenix serve`, UI at http://localhost:6006)
PHOENIX_ENABLED=false
PHOENIX_PROJECT=financial-advisor-service
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
